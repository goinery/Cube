{
  "name": "axis-cube-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "AXIS / 03 — interactive magnetic cube studio",
  "scripts": {
    "dev": "node scripts/launch.mjs dev",
    "build": "npm run setup && node scripts/launch.mjs build",
    "start": "node scripts/launch.mjs start",
    "verify": "node scripts/launch.mjs verify",
    "verify:pyraminx": "node scripts/launch.mjs verify:pyraminx",
    "setup": "npm install --prefix web",
    "deploy": "wrangler deploy",
    "verify:solvers": "node scripts/launch.mjs verify:solvers",
    "verify:views": "node scripts/launch.mjs verify:views",
    "verify:render-optimization": "node scripts/launch.mjs verify:render-optimization"
  },
  "devDependencies": {
    "wrangler": "4.130.0"
  }
}
